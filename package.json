{
  "name": "slidev-theme-one-purple-unicorn-pro",
  "version": "4.0.0",
  "packageManager": "npm@12.2.2",
  "type": "module",
  "description": "One Purple Unicorn Pro theme for Slidev - Purple/Indigo focused theme with clean macOS style",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=22.12.0",
    "slidev": ">=53.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11",
      "onFail": "error"
    }
  },
  "author": {
    "name": "Hawk",
    "email": "hawking90a@gmail.com"
  },
  "files": [
    "fonts/**/*",
    "layouts/**/*",
    "components/**/*",
    "styles/**/*",
    "setup/**/*",
    "utils/**/*",
    "uno.config.ts",
    "global-top.vue",
    "global-bottom.vue",
    "custom-nav-controls.vue",
    "index.html",
    "styles.css",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hawk90/slidev-theme-one-purple-unicorn-pro.git"
  },
  "homepage": "https://github.com/hawk90/slidev-theme-one-purple-unicorn-pro",
  "bugs": {
    "url": "https://github.com/hawk90/slidev-theme-one-purple-unicorn-pro/issues"
  },
  "license": "MIT",
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "fonts": {
        "sans": "Noto Sans KR, Inter",
        "serif": "Noto Serif KR",
        "mono": "JetBrains Mono, Fira Code",
        "weights": "400"
      }
    }
  },
  "dependencies": {
    "@slidev/types": ">=53.0.0",
    "katex": "^0.19.0",
    "shiki": "^4.4.3"
  },
  "scripts": {
    "check:decks": "node scripts/check-decks.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "check:slidev": "node scripts/check-slidev-internals.mjs",
    "regress": "node scripts/regress.mjs",
    "test": "node --test 'test/*.test.ts'"
  },
  "peerDependencies": {
    "echarts": ">=5"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    }
  },
  "devDependencies": {
    "echarts": "^5.6.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.17"
    }
  }
}
