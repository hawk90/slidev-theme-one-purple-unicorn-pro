#!/usr/bin/env bash
# $1 = previous HEAD, $2 = new HEAD, $3 = 1 for a branch checkout
[ "${3:-0}" = 1 ] || exit 0
# A rebase checks out <onto> first; post-rewrite syncs once it finishes.
# (Only the default merge backend has rebase-merge/ at this point.)
[ -d "$(git rev-parse --git-path rebase-merge)" ] && exit 0
exec "$(git rev-parse --show-toplevel)/scripts/sync-deps.sh" --since "$1"
